# CIVRAT runtime configuration
# Copy this file to .env and replace all placeholder values locally.
# Never commit a real .env file or credentials.
# (P12.1 — les valeurs réelles précédemment présentes ici ont été retirées ;
#  la rotation des clés exposées reste à la charge du propriétaire du projet.)

# Required by the current Discord bot runtime
DISCORD_TOKEN=replace-with-your-discord-bot-token
CLIENT_ID=replace-with-your-discord-application-id
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Optional slash-command deployment controls (see deploy.js)
# DEPLOY_COMMANDS=1 -> one-shot deploy at startup, then normal bot startup.
# any other value   -> normal startup, no deploy (no PUT on every restart).
DEPLOY_COMMANDS=0
# Optional guild-scoped deploy target (instant propagation for testing).
# Leave empty to deploy globally (can take time to propagate, Discord behavior).
DEPLOY_GUILD_ID=

# Optional MongoDB runtime (dynamic/high-write data only)
# The current bot can start without MongoDB, but features such as XP, temporary
# voice, invite statistics, giveaway entries, and suggestion votes may be unavailable.
# Laissez vide hors usage Mongo ; format d'URI documenté par votre provider.
MONGO_URI=
MONGO_DB_NAME=civrat

# Legacy dashboard/API transition settings
# No new feature may depend on these variables. They remain documented only while
# the legacy Express API is still present during the progressive dashboard removal.
API_PORT=3001
API_SECRET=replace-with-a-long-random-string
DASHBOARD_URL=https://dashboard.example.com
DISCORD_CLIENT_SECRET=replace-with-your-discord-client-secret
DISCORD_REDIRECT_URI=https://dashboard.example.com/callback
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
LEGACY_GUILD_ID=1234567890123456789

# Owner recovery (P20) — double facteur : Master Code permanent + code
# temporaire e-mail (usage unique, courte expiration).
# Les valeurs réelles se définissent UNIQUEMENT dans les variables du hosting ;
# ne jamais les mettre dans Git. Le bot n'en logge ni n'affiche jamais le
# contenu. Laisser vide => la récupération est simplement indisponible.
RECOVERY_MASTER_CODE=
RECOVERY_EMAIL=

# SMTP (compatible Brevo : smtp-relay.brevo.com, 587 STARTTLS ou 465 TLS).
# Host/port/user/password standards — aucune valeur réelle dans le dépôt.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Owner Panel (P20) — identité CIVRAT (différente du Discord Server Owner).
# CIVRAT_OWNER_ID : identifiant Discord de l'Owner CIVRAT initial (un ID
# public, pas un secret). Renseigné par le propriétaire dans le hosting.
CIVRAT_OWNER_ID=
# Codes secrets env-only : JAMAIS dans Git, JAMAIS dans les logs, JAMAIS de
# valeur par défaut. Vides => Owner Panel et transfert indisponibles
# (fail-closed). Ne jamais les communiquer à un outil ou un tiers.
OWNER_PANEL_MASTER_CODE=
OWNER_TRANSFER_CODE=
